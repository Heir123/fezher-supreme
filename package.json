{
  "name": "bizflow",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest --config vitest.no-setup.config.js --run --no-isolate --testTimeout=120000",
    "test:simple": "vitest --config vitest.no-setup.config.js --run --no-isolate --testTimeout=120000 src/tests/simple.test.jsx",
    "test:watch": "vitest --config vitest.no-setup.config.js --watch --no-isolate --testTimeout=120000",
    "test:coverage": "vitest --config vitest.no-setup.config.js --coverage --run --no-isolate --testTimeout=120000",
    "test:single": "vitest --config vitest.no-setup.config.js --run --no-isolate --testTimeout=120000",
    "test:ui": "vitest --config vitest.no-setup.config.js --ui --no-isolate --testTimeout=120000",
    "test:all": "node run-tests-sequential.js",
    "test:debug": "vitest --config vitest.no-setup.config.js --run --inspect --no-isolate --reporter=verbose --testTimeout=120000",
    "test:sequential": "node run-tests-sequential.js",
    "test:verbose": "vitest --config vitest.no-setup.config.js --run --no-isolate --reporter=verbose --testTimeout=120000",
    "test:threads": "vitest --config vitest.no-setup.config.js --run --pool=threads --maxWorkers=1 --no-isolate --testTimeout=120000",
    "test:clear": "vitest --clear-cache",
    "test:kill": "taskkill /F /IM node.exe",
    "test:reset": "npm run test:kill && npm run test:clear",
    "test:no-setup": "vitest --config vitest.no-setup.config.js --run --no-isolate --testTimeout=120000",
    "test:root-setup": "vitest --config vitest.config.js --run --no-isolate --testTimeout=120000",
    "test:working": "vitest --config vitest.working.config.js --run --no-isolate --testTimeout=120000",
    "test:minimal": "vitest --config vitest.no-setup.config.js --run --no-isolate --testTimeout=120000 src/tests/simple.test.jsx",
    "test:basic": "vitest --config vitest.no-setup.config.js --run --no-isolate --testTimeout=120000 src/tests/basic.test.js"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/geist": "^5.2.9",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@react-pdf/renderer": "^4.6.1",
    "@supabase/supabase-js": "^2.110.0",
    "@tailwindcss/vite": "^4.3.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dom-to-image": "^2.6.0",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.25.0",
    "next-themes": "^0.4.6",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.6.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.10.1",
    "resend": "^6.18.1",
    "shadcn": "^4.12.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "supabase": "^2.114.0",
    "vite": "^8.1.0",
    "vitest": "^4.1.10"
  }
}